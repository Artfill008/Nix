# Середовище розробки.
#
# ПРИНЦИП (твоє рішення): AI-assisted development first.
# База дає універсальну build-інфраструктуру і агентів, але НЕ тягне глобально
# жоден language toolchain. Rust, Node, Go, Java — усе per-project через
# devShell + direnv. Це і швидший rebuild, і відсутність конфліктів версій.
{
  config,
  lib,
  pkgs,
  username,
  ...
}:
{
  environment.systemPackages = with pkgs; [
    # ── AI-агенти: first-class ────────────────────────────────────────────────
    # Обидва є в nixpkgs (перевірено: pkgs/by-name/cl/claude-code, by-name/co/codex).
    # Це принципово краще за npm -g: агент оновлюється разом із системою,
    # версія зафіксована у flake.lock, і немає мутабельного ~/.npm-global.
    #
    # ВАЖЛИВО, чого треба очікувати: обидва оновлюються часто, а nixpkgs
    # відстає на дні-тижні. Коли треба свіжіша версія за ту, що в lock —
    # це `nix flake update nixpkgs`, а не окремий канал.
    claude-code
    codex

    # Агентам потрібне робоче середовище, а не лише вони самі.
    # Нижче — рівно те, що вони реально викликають.

    # ── Git ───────────────────────────────────────────────────────────────────
    git
    git-lfs # великі файли: моделі, ассети, APK
    gh # GitHub CLI — агенти вміють ним користуватись
    delta # читабельний diff; git налаштований на нього в home/shell.nix

    # ── Пошук і навігація по коду ─────────────────────────────────────────────
    # Це те, чим агент замінює «відкрити файл очима». Швидкість тут прямо
    # впливає на те, скільки агент встигне за крок.
    ripgrep
    fd
    tree
    jq # JSON — і для агентів, і для `nix ... --json`
    yq-go # те саме для YAML

    # ── Базові UNIX-утиліти, які агенти вважають наявними ─────────────────────
    curl
    wget
    file
    patch
    diffutils
    less
    which

    # ── Архіви ────────────────────────────────────────────────────────────────
    # (Дублювання з apps.nix свідоме: там вони як бекенди file-roller,
    # тут — як CLI-інструменти. Nix дедуплікує, у стор потрапить один шлях.)
    unzip
    zip
    gnutar
    gzip
    xz
    zstd

    # ── Build-інфраструктура ──────────────────────────────────────────────────
    # Загальна, не прив'язана до мови. Потрібна, щоб зібрався будь-який
    # sys-crate у Rust, будь-який native-модуль у Node тощо.
    gnumake
    cmake
    ninja
    pkg-config
    gcc
    clang
    # binutils дає ld/objdump/nm — без нього лінкування native-коду не працює.
    binutils

    # ── Python ────────────────────────────────────────────────────────────────
    # uv — твій вибір, і він об'єктивно правильний на NixOS: керує і версіями
    # інтерпретатора, і залежностями, і віртуальними оточеннями, тримаючи все
    # у проєкті. Глобального python3 з пакетами свідомо НЕ ставимо — це
    # найшвидший спосіб отримати конфлікт із Nix-пітоном.
    # Програв poetry/pipenv: повільніші, менше вміють.
    uv

    # distrobox — escape hatch: коли зовнішня інструкція передбачає
    # FHS-дистрибутив, а переписувати її під Nix дорожче, ніж підняти
    # Ubuntu-контейнер із доступом до $HOME. Працює поверх podman вище.
    distrobox

    # ── Nix-тулінг ────────────────────────────────────────────────────────────
    nix-output-monitor # nom — читабельний прогрес замість стіни тексту
    nix-tree           # дослідити, чому замикання таке велике
    nvd # nvd diff — що змінилось між поколіннями
    nh # людський UX над nixos-rebuild
    nixfmt # канонічний форматер (nixfmt-rfc-style тепер deprecated alias)
    nil # LSP для Nix — агенти й редактори бачать помилки одразу
    statix # лінтер антипатернів у Nix
    deadnix # знаходить мертві прив'язки
  ];

  # ── direnv ──────────────────────────────────────────────────────────────────
  # Ключовий елемент усієї схеми «toolchain живе в проєкті».
  # Заходиш у теку → devShell піднімається сам; виходиш → зникає з PATH.
  programs.direnv = {
    enable = true;
    # nix-direnv кешує результат `nix develop`. Без нього кожен `cd` у проєкт
    # заново оцінює flake — це секунди затримки на кожен крок агента.
    nix-direnv.enable = true;
    # silent: не засмічує вивід агента повідомленнями direnv при кожному cd.
    silent = true;
  };

  # ── Контейнери ──────────────────────────────────────────────────────────────
  # Podman, а не Docker. Виграв: rootless за замовчуванням — немає демона від
  # root, до якого має доступ будь-хто з групи docker (а це фактично root).
  # Для машини, де AI-агенти виконують команди, це не формальність.
  virtualisation.podman = {
    enable = true;
    # docker-сумісний сокет і аліас `docker` → інструкції з інтернету
    # і агенти працюють без переписування команд.
    dockerCompat = true;
    dockerSocket.enable = true;
    # DNS між контейнерами в user-мережах.
    defaultNetwork.settings.dns_enabled = true;
  };


  # ── Syncthing ───────────────────────────────────────────────────────────────
  # Мій вибір (ти лишив на мій розсуд): P2P-синхронізація без хмари.
  # Логічний партнер до Android-workflow — файли з телефона на ноут без кабелю
  # і без чужого сервера.
  services.syncthing = {
    enable = true;
    user = username;
    dataDir = "/home/${username}";
    configDir = "/home/${username}/.config/syncthing";
    # Веб-UI лише на localhost. Назовні не відкриваємо.
    guiAddress = "127.0.0.1:8384";
    # TODO: пристрої та теки додай через веб-UI на http://127.0.0.1:8384
    # або опиши їх тут декларативно (settings.devices / settings.folders).
    # Свідомо лишаю порожнім: список твоїх пристроїв — це персональні дані,
    # а не частина бази дистрибутива.
  };
  # Порти Syncthing у фаєрволі. 22000 — трафік, 21027/udp — виявлення в LAN.
  networking.firewall = {
    allowedTCPPorts = [ 22000 ];
    allowedUDPPorts = [
      22000
      21027
    ];
  };
}
