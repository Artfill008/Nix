# Обслуговування сховища. Те, чого не було у твоєму початковому списку,
# але без чого btrfs тихо деградує, а NVMe вмирає без попередження.
{
  config,
  lib,
  pkgs,
  username,
  ...
}:
{
  # ── Снапшоти: btrbk ─────────────────────────────────────────────────────────
  # Раніше тут був Snapper. Рішення змінене користувачем на btrbk
  # (docs/DECISIONS.md, D-024; попереднє D-024a позначене SUPERSEDED).
  #
  # ЧОМУ btrbk ТУТ ЗРУЧНІШИЙ ЗА Snapper:
  #   • не потребує вкладеного .snapshots всередині КОЖНОГО підтому —
  #     складає все в один каталог, що краще лягає на розкладку @ @home @snapshots;
  #   • один конфіг замість набору per-subvolume конфігів;
  #   • той самий інструмент потім робить і бекап на зовнішній диск,
  #     коли він знадобиться — без другої підсистеми.
  # Що програв Snapper: інтеграція з boot-меню (у нас її і не було, бо
  # systemd-boot не вміє btrfs-снапшоти) і GUI (ми ним не користуємось).
  #
  # ДВА НЕЗАЛЕЖНІ РІВНІ ВІДКАТУ, які це дає разом із NixOS:
  #   NixOS generations → відкочують СИСТЕМУ (/nix/store + конфіг)
  #   btrbk snapshots   → відкочують ДАНІ (/home) і стан кореня
  # Одне не замінює інше: rollback покоління не поверне видалений файл,
  # а снапшот не поверне зламану конфігурацію ядра.
  services.btrbk = {
    # Знижений пріоритет: снапшот не має конкурувати з інтерактивною роботою.
    niceness = 10;
    ioSchedulingClass = "idle";

    instances.local = {
      onCalendar = "hourly";

      # ЛИШЕ локальні снапшоти, без надсилання кудись.
      # Коли з'явиться зовнішній диск — сюди додається `target`, і той самий
      # btrbk почне робити ще й бекап. Другої підсистеми не знадобиться.
      snapshotOnly = true;

      settings = {
        timestamp_format = "long";

        # Скільки тримати. Формат btrbk: <годинні> <денні> <тижневі> <місячні>.
        # Підібрано під десктоп на 1 ТБ: btrfs-снапшот займає місце лише під
        # ЗМІНИ, тому глибина в тижнях коштує дешево, а рятує часто.
        snapshot_preserve_min = "2d"; # молодші за 2 дні не чіпати ніколи
        snapshot_preserve = "48h 14d 8w 6m";

        # ── Ключова деталь розкладки ──────────────────────────────────────────
        # btrbk має бачити btrfs НА РІВНІ TOP-LEVEL (subvolid=5), інакше він
        # не зможе створювати снапшоти сусідніх підтомів. Тому в
        # hosts/gt72s/hardware-configuration.nix додано монтування /.btrfs.
        volume."/.btrfs" = {
          # Усі снапшоти складаються в підтом @snapshots — той самий, що
          # заданий у LOCKED-розкладці. Він свідомо ЗОВНІ @ і @home,
          # щоб снапшот кореня не містив сам себе.
          snapshot_dir = "@snapshots";

          subvolume = {
            # Корінь: за запитом, не за таймером. На NixOS він майже незмінний —
            # усе цікаве живе в /nix (який ми не снапшотимо) і в /home.
            "@" = {
              snapshot_create = "ondemand";
            };
            # Дані: завжди.
            "@home" = {
              snapshot_create = "always";
            };
            # @nix СВІДОМО ВІДСУТНІЙ — D-023.
            # Стор відтворюється з flake.lock, а снапшоти стору з'їли б диск
            # за тиждень: кожен rebuild переписує тисячі шляхів.
            # @log теж не снапшотимо — журнали не варті місця.
          };
        };
      };
    };
  };

  # ── SMART / здоров'я NVMe ───────────────────────────────────────────────────
  # 970 EVO Plus — хороший диск, але це TLC із обмеженим ресурсом запису,
  # а /nix пише багато. Хочемо знати про зношення ДО відмови.
  services.smartd = {
    enable = true;
    # Сповіщення на десктоп, а не листом у нікуди.
    notifications.wall.enable = true;
    autodetected = true;
    defaults.autodetected = "-a -o on -S on -s (S/../.././02|L/../../6/03)";
  };

  # nvme-cli для ручної перевірки: `sudo nvme smart-log /dev/nvme0`
  # Показує percentage_used, media_errors, температуру.
  environment.systemPackages = with pkgs; [
    nvme-cli
    smartmontools
    compsize # скільки реально займають дані на btrfs після стиснення
    btrfs-progs
  ];

  # ── TRIM ────────────────────────────────────────────────────────────────────
  # У hardware-configuration.nix підтоми монтуються з discard=async —
  # це безперервний фоновий TRIM, і його зазвичай достатньо.
  # Періодичний fstrim лишаємо ВИМКНЕНИМ свідомо: два механізми TRIM
  # одночасно не ламають диск, але дублюють роботу.
  # Якщо колись прибереш discard=async — увімкни це.
  services.fstrim.enable = false;

  # ── Журнал і дампи ──────────────────────────────────────────────────────────
  # Coredump за замовчуванням може з'їсти гігабайти після падіння
  # чогось великого (браузер, емулятор Android).
  systemd.coredump = {
    enable = true;
    extraConfig = ''
      Storage=external
      Compress=yes
      MaxUse=2G
      KeepFree=5G
      ProcessSizeMax=8G
    '';
  };
}
