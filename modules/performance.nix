# Оптимізація. Усе декларативно: жодних скриптів у /etc, жодного `echo > /sys`
# з rc.local. Там, де потрібен запис у sysfs, використовуємо systemd.tmpfiles
# або udev-правила — це теж декларація, а не скрипт.
{
  config,
  lib,
  pkgs,
  ...
}:
{
  # ── sched_ext: scx_lavd ─────────────────────────────────────────────────────
  # LAVD = Latency-criticality Aware Virtual Deadline. Написаний під ігри та
  # інтерактив: він явно виділяє «латентно-критичні» задачі (ті, що часто
  # прокидаються і мало рахують — композитор, аудіо, ввід) і дає їм коротший
  # дедлайн.
  # Програв scx_rustland (дефолт модуля): планувальна логіка живе в юзерспейсі
  #   на Rust — гнучко, але зайвий стрибок у планувальному шляху.
  # Програв scx_bpfland: близький родич, теж інтерактивний, але LAVD краще
  #   поводиться саме на малому числі ядер (4C/8T) — він не намагається
  #   розкидати по «доменах», яких у нас фактично нема.
  # Рівність, чесно: між lavd і bpfland різниця в межах похибки на десктопі.
  # Якщо lavd поводитиметься дивно — bpfland міняється одним рядком.
  services.scx = {
    enable = true;
    scheduler = "scx_lavd";
    # Модуль містить assertion на kernel >= 6.12 — тому ми і взяли 6.12 LTS.
  };

  # ── zram ────────────────────────────────────────────────────────────────────
  # 16 ГБ стисненого свопу в RAM. При 48 ГБ фізичної це ~33%.
  # zstd, бо на Skylake він дає ~3x стиснення при швидкості, що все одно
  # у сотні разів вища за NVMe. lz4 швидший, але стискає гірше — на цьому
  # обсязі RAM економія важливіша за наносекунди.
  zramSwap = {
    enable = true;
    algorithm = "zstd";
    memoryPercent = 34;
    # Жорстка стеля в байтах. Модуль бере min(memoryPercent, memoryMax).
    memoryMax = 16 * 1024 * 1024 * 1024;
    # Пріоритет вищий за будь-який дисковий своп (якого в нас і немає).
    priority = 100;
  };

  # ── systemd-oomd ────────────────────────────────────────────────────────────
  # Вбиває процеси ДО того, як ядро зайде в OOM-storm і система застигне
  # на хвилини. Працює по cgroup і по тиску пам'яті (PSI), а не по «раптом
  # скінчилась пам'ять».
  systemd.oomd = {
    enable = true;
    enableRootSlice = true;
    enableSystemSlice = true;
    enableUserSlices = true;
  };

  # ── Параметри ядра ──────────────────────────────────────────────────────────
  boot.kernelParams = [
    # Повністю витісняюче ядро. Найкраща латентність вводу/аудіо, ціна —
    # кілька відсотків пропускної здатності на масових збірках.
    "preempt=full"

    # Skylake має баг: split lock (атомарна операція через межу кеш-лінії)
    # ловиться ядром і карає процес зупинкою на ~десятки мс. Багато ігор
    # і Wine це роблять. Вимикаємо детектор.
    "split_lock_detect=off"

    # NMI watchdog не потрібен на десктопі: він постійно тикає на кожному ядрі,
    # заважає глибоким C-станам і псує показники енергоспоживання.
    "nowatchdog"

    # 970 EVO Plus + APST = класичні NVMe-таймаути на Samsung.
    # 0 забороняє переходити в глибокі power-стани контролера.
    # Ціна: +1-2 Вт у простої. Вигода: диск не відвалюється.
    "nvme_core.default_ps_max_latency_us=0"

    # s2idle на цьому поколінні MSI зроблений погано (ноут гріється в сумці).
    # deep = класичний S3, який GT72S підтримує апаратно.
    "mem_sleep_default=deep"

    # KMS для NVIDIA. Дублює hardware.nvidia.modesetting.enable — свідомо,
    # щоб параметр було видно в /proc/cmdline без розкопок.
    "nvidia-drm.modeset=1"

    # Збереження VRAM через сон. Форма для командного рядка ядра
    # (форма для modprobe — у modules/nvidia.nix; працює будь-яка з них,
    # NVIDIA-модуль читає обидві).
    "nvidia.NVreg_PreserveVideoMemoryAllocations=1"

    # Transparent Huge Pages у режимі madvise: сторінки 2 МБ дає лише тим,
    # хто явно попросив (JVM, БД, деякі ігри). `always` на десктопі призводить
    # до стрибків латентності при дефрагментації.
    "transparent_hugepage=madvise"

    # ─────────────────────────────────────────────────────────────────────────
    # МІТИГАЦІЇ: вимкнені за твоїм явним рішенням.
    #
    # Що це реально означає на i7-6820HK:
    #   • Meltdown (KPTI), Spectre v1/v2, MDS, TAA, L1TF, SRBDS — усе вимкнено.
    #   • Виграш: ~5-20% на syscall-важких навантаженнях (nix build, libvirt,
    #     компіляція, файлові операції). На іграх — одиниці відсотків.
    #   • Ризик: код у пісочниці (JS у вкладці браузера, гостьова ОС у ВМ)
    #     отримує канал читання чужої пам'яті. Це не теорія — під Skylake
    #     існують робочі PoC.
    #
    # Часткова компенсація, яка ЛИШАЄТЬСЯ активною:
    #   • Апаратні виправлення в мікрокоді (hardware.cpu.intel.updateMicrocode
    #     увімкнено в hardware-configuration.nix) — вони працюють незалежно
    #     від mitigations=off. Для Skylake це MSR-фікси для v2/MDS частково.
    #   • Ізоляція ВМ на рівні KVM лишається; ламається саме спекулятивний бар'єр.
    #
    # Щоб повернути назад — просто прибери цей рядок і зроби rebuild.
    # Перевірити поточний стан: grep . /sys/devices/system/cpu/vulnerabilities/*
    "mitigations=off"
  ];

  # ── sysctl ──────────────────────────────────────────────────────────────────
  boot.kernel.sysctl = {
    # Агресивно виштовхувати в zram. 180 має сенс ТІЛЬКИ коли своп у RAM:
    # «свопнути» = стиснути сторінку, а не піти на диск. При 100 система
    # тримає холодні сторінки в RAM нестиснутими і марнує пам'ять.
    "vm.swappiness" = 180;

    # 0 = читати рівно одну сторінку за раз. Для дискового свопу читання
    # пачками економить seek-и; для zram seek-ів немає, а зайві сторінки —
    # це зайва робота декомпресора.
    "vm.page-cluster" = 0;

    # Скільки «брудних» (незаписаних) даних дозволяємо тримати.
    # Дефолт у відсотках від RAM: 20% від 48 ГБ = ~9.6 ГБ. Це означає, що
    # система може накопичити 9.6 ГБ і потім намертво стати на flush.
    # Фіксовані байти вбивають цей клас фризів.
    "vm.dirty_bytes" = 268435456; # 256 МБ — поріг, після якого пише той, хто пише
    "vm.dirty_background_bytes" = 67108864; # 64 МБ — коли фоновий flush прокидається

    # 50 замість 100: тримати dentry/inode-кеш удвічі довше.
    # На btrfs з великою кількістю дрібних файлів (а /nix — саме такий)
    # це помітно на `nix build` і на обході дерева.
    "vm.vfs_cache_pressure" = 50;

    # Максимум mmap-регіонів на процес. Дефолт (65530) ламає сучасні ігри
    # через Proton/Wine, DXVK і Electron. Значення — це те, що використовує
    # SteamOS; воно не резервує пам'ять, а лише піднімає стелю.
    "vm.max_map_count" = 2147483642;

    # Мережа: BBR + fq. На Wi-Fi з непостійною затримкою BBR помітно кращий
    # за cubic. fq потрібен BBR для pacing.
    "net.core.default_qdisc" = "fq";
    "net.ipv4.tcp_congestion_control" = "bbr";

    # Дозволяє інструментам профілювання (perf) працювати без root.
    "kernel.perf_event_paranoid" = 1;

    # Скільки inotify-вотчерів. Дефолт швидко закінчується на IDE,
    # файлових менеджерах і dev-серверах.
    "fs.inotify.max_user_watches" = 524288;
  };

  # ── MGLRU ───────────────────────────────────────────────────────────────────
  # Multi-Gen LRU. У 6.12 код у ядрі є, але прапорець вмикання може бути
  # вимкнений у конфізі збірки. Пишемо в sysfs декларативно через tmpfiles.
  # 0x0007 = увімкнути всі три можливості (core, clear-young, memcg).
  # ПЕРЕВІР ПІСЛЯ ЗАВАНТАЖЕННЯ: cat /sys/kernel/mm/lru_gen/enabled
  # Якщо файлу немає — MGLRU не вкомпільований, і рядок нижче просто мовчки
  # нічого не зробить (tmpfiles не падає на відсутньому шляху з 'w-').
  systemd.tmpfiles.rules = [
    "w- /sys/kernel/mm/lru_gen/enabled - - - - 0x0007"
    # Розмір буфера пакетної роботи MGLRU. 1000 мс — рекомендація апстріму
    # для десктопу; менше = агресивніше відстеження, більше CPU.
    "w- /sys/kernel/mm/lru_gen/min_ttl_ms - - - - 1000"
  ];

  # ── Планувальник вводу-виводу ───────────────────────────────────────────────
  # Для NVMe — `none` (він же noop). У NVMe черга апаратна і глибока;
  # будь-який софтовий планувальник тільки додає латентності.
  # mq-deadline мав би сенс на SATA SSD, bfq — на HDD.
  services.udev.extraRules = ''
    # NVMe: без планувальника
    ACTION=="add|change", KERNEL=="nvme[0-9]n[0-9]", ATTR{queue/scheduler}="none"
    # Заодно: не витрачати CPU на статистику вводу-виводу, якою ми не користуємось
    ACTION=="add|change", KERNEL=="nvme[0-9]n[0-9]", ATTR{queue/iostats}="0"
    # Глибина черги на запит — NVMe тягне більше за дефолтні 128
    ACTION=="add|change", KERNEL=="nvme[0-9]n[0-9]", ATTR{queue/nr_requests}="1024"
  '';

  # ── Профілі живлення ────────────────────────────────────────────────────────
  # TuneD, а не power-profiles-daemon.
  # Чому: PPD вміє рівно три статичні профілі і нічого більше. TuneD — це
  # набір плагінів (cpu, disk, audio, video, scheduler, bootloader), кожен
  # з яких реагує на подію «змінилось джерело живлення». Саме те, що ти просив
  # під «governor/tuned під плагін живлення».
  # Програв auto-cpufreq: робить одну річ (governor) і робить її як демон
  #   з власним циклом опитування — дублює те, що вже вміє ядро.
  # ВАЖЛИВО: ppdSupport=true віддає TuneD D-Bus-ім'я power-profiles-daemon,
  # тому GNOME/KDE/waybar-віджети бачать його як звичайний PPD.
  services.tuned = {
    enable = true;
    ppdSupport = true;

    settings = {
      # Профіль за замовчуванням, коли ppdSupport не диктує інше.
      dynamic_tuning = true;
      # Як часто перевіряти навантаження для динамічних плагінів.
      update_interval = 10;
    };

    ppdSettings = {
      main.default = "balanced";
      # Відповідність «слайдер у трей» → «профіль TuneD».
      profiles = {
        power-saver = "powersave";
        balanced = "balanced";
        performance = "throughput-performance";
      };
      battery = {
        # На батареї навіть у «performance» не даємо повний розгін —
        # на GT72S це 8 хвилин автономності і 90°C.
        performance = "balanced";
      };
    };
  };

  # power-profiles-daemon вимикаємо явно: він і TuneD конфліктують
  # за один D-Bus-адресу. Якщо лишити обидва — сервіс просто не стартує.
  services.power-profiles-daemon.enable = false;

  # ── Термальний демон Intel ──────────────────────────────────────────────────
  # thermald — це «дорослий» варіант того, що ти описав у пункті про
  # turbo-обмеження при 70°C: він читає DTS/INT3400, і керує RAPL та
  # cpufreq з правильним гістерезисом, PID-регулятором і врахуванням
  # теплової інерції. Свій наївний on/off робити НЕ треба (див. modules/laptop/msi-ec.nix).
  services.thermald.enable = true;

  # ── Дрібниці ────────────────────────────────────────────────────────────────
  # earlyoom НЕ ставимо: systemd-oomd робить те саме, але через PSI і cgroups,
  # тобто точніше. Два OOM-кілери одночасно — це гонка за те, хто вб'є перший.

  # Журнал: обмежуємо, щоб не з'їв диск і не сповільнював завантаження.
  services.journald.extraConfig = ''
    SystemMaxUse=512M
    SystemMaxFileSize=64M
    MaxRetentionSec=1month
  '';

  # Прибираємо затримку 90 с при вимкненні, коли сервіс завис.
  systemd.extraConfig = ''
    DefaultTimeoutStopSec=15s
  '';
}
