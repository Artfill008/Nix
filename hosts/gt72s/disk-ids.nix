# ║  ЦЕЙ ФАЙЛ ГЕНЕРУЄ `bootstrap.sh`. Правити руками можна, але при            ║
# ║  наступному запуску bootstrap перезапише його (зробивши бекап).            ║
# ╚═══════════════════════════════════════════════════════════════════════════╝
#
# ЧОМУ ЦЕ ОКРЕМИЙ ФАЙЛ:
# Тут лежить ЛИШЕ те, що є унікальним для конкретного примірника заліза —
# ідентифікатори розділів. Уся ПОЛІТИКА (опції монтування, підтоми,
# стиснення, TRIM, мікрокод) живе в hardware-configuration.nix і
# НЕ перезаписується детекцією.
#
# Це розділення потрібне саме тому, що `nixos-generate-config` генерує свій
# hardware-configuration.nix із дефолтними опціями монтування. Якби bootstrap
# просто підставляв його файл, ми б щоразу втрачали compress=zstd,
# discard=async, noatime і розкладку підтомів.
#
#   детекція  →  disk-ids.nix              (машинозалежне, генерується)
#   політика  →  hardware-configuration.nix (кураторське, у git)
{
  # UUID файлової системи btrfs (один на всі підтоми).
  # Дізнатись вручну:  lsblk -f   або   blkid
  gt72s.disk.rootUuid = "00000000-0000-0000-0000-000000000000";

  # UUID EFI-розділу. Він короткий, вигляду 1234-ABCD.
  gt72s.disk.espUuid = "0000-0000";
}
